!doc/test/evidence/s7/env/

# ---- IDE / OS ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 临时文件 ----
tmp/
*.tmp
pytest_out.txt
reports_junit.xml
# 仅忽略仓库根目录的运行时日志目录；不得命中 openbase/modules/logs/（源码模块）
/logs/

# ---- 本地存储测试数据 ----
storage/

# ---- 本地运行时（Keycloak 发行版等本地基础设施，绝不提交）----
.runtime/

# ---- 本地 OIDC IdP 私钥（运行时生成，绝不提交）----
scripts/oidc-idp/keys/

# ---- verify-env 生成报告（脚本运行输出物；证据副本登记 doc/test/evidence/）----
scripts/verify-env-report.json

# ---- S6 Playwright 运行期产物（证据仅保留 results.json / status.json；HTML report 与 trace 不入库）----
doc/test/evidence/s6/ui-e2e/report/
doc/test/evidence/s6/ui-e2e/artifacts/
