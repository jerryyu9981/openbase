# ---- 敏感信息（绝不提交）----
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
.ssh/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
*.log

# ---- Node / 前端依赖与工具缓存 ----
node_modules/
.vite/

# ---- 虚拟环境 ----
.venv/
venv/
env/
