  "_meta": {
    "id": "cr149-eval-set",
    "version": "v1.0.0",
    "created": "2026-09-28",
    "purpose": "CR-149 判据 T3 段③：rerank 开 / 关的**聚合对照**（检索侧口径，可复跑）",
    "nature": "**构造样本，非生产数据** —— `score` 为构造的 rerank 后分数、`relevant` 为构造标注；本集用于验证**过滤与重排口径**的确定性与可复跑性，**不代表**真实检索质量",
    "filter_semantics": "网关**不本地过滤**：`score_threshold` 下传检索服务（T3 段① 只验「口径」）。故本集的过滤为该口径的**夹具仿真**，不等于真实检索路径",
    "rerank_on": "按 `score` 降序、过滤 `score < score_threshold` 的条目",
    "rerank_off": "不过滤、保持原序（`score_threshold<=0` ⇒ None ⇒ 网关不过滤）",
    "score_threshold": 0.15,
    "groups": {
      "assert": "参与**硬断言**（条目数下降 / 相关项保留率不降 / 噪声剔除率上升）",
      "stress": "**仅观测**：相关项分数低于阈值 —— 用于暴露固定阈值的适用边界，不作硬断言"
    },
    "used_ratio_note": "本集**不含** `used_ratio`（归因 A 指标，取值依赖 LLM 回答内容）⇒ 该子句仍属**运行态**，见 `t_acceptance_runner.py` T3 的 `evaluation_pending`（理由已收窄为「仅缺运行态数据」）"
  },
